# Copy file nay thanh .env roi doi gia tri. KHONG commit .env.
#
#   cp .env.example .env
#
# Mat khau SA cua SQL Server. Yeu cau cua SQL Server: it nhat 8 ky tu,
# co chu hoa, chu thuong, so va ky tu dac biet.
MSSQL_SA_PASSWORD=Doi_Mat_Khau_Nay_123!

# Khoa ky JWT. Toi thieu 32 ky tu, nen sinh ngau nhien:
#   openssl rand -base64 48
JWT_KEY=doi-thanh-chuoi-ngau-nhien-it-nhat-32-ky-tu-truoc-khi-dung-that

# Mat khau cua tai khoan admin@nhagiakim.local duoc seed lan dau.
SEED_ADMIN_PASSWORD=Admin@12345

# Bat Swagger trong container de demo. Trien khai that thi dat false.
SWAGGER_ENABLED=true

# Cong tren may that. Doi neu bi trung.
FRONTEND_PORT=8080
API_PORT=5080
SQLSERVER_PORT=1433
